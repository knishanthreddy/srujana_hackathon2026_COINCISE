# COINCISE Environment Configuration
# Copy this file to .env.local to configure real Supabase credentials.
# If these are left blank or omitted, COINCISE operates in Offline Demo Mode using local storage.

# Supabase Public API URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Safe for client-side usage with Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Secret (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Google Gemini API Key (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used by COINCISE Assistant (/api/assistant) for intelligent in-app guidance.
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AQ.Ab8RN6K-4IrWVe8ILye3Tt4ftFiTUvXKqPXY2-cK72UIzu4h6w

